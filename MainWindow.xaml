<Window x:Class="RetainerMarketScout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FF14 Retainer Market Scout"
        Icon="Resource/RetainerMarketScout.ico"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F14"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121821"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#18202B"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#273142"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E7ECF3"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8D99A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#37D5FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#163847"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0F151D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#121821"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7ECF3"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#163847"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#1A2634"/>
            <Setter Property="BorderBrush" Value="#334257"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#223145"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#37D5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#163847"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5F6B7B"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#111821"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#222B39"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#162131"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#203247"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#A12217"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0F151D"/>
            <Setter Property="BorderBrush" Value="#334257"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#0F151D"
                                                BorderBrush="#334257"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{StaticResource SubtleTextBrush}"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#37D5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#0B0F14"
                                        BorderBrush="#334257"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Background="#0B0F14"
                                                  MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0F151D"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#163847"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1B4658"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0F151D"/>
            <Setter Property="BorderBrush" Value="#334257"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="ResultGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0B0F14"/>
            <Setter Property="BorderBrush" Value="#273142"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ResultGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#163847"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#37D5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="#0F151D"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#222B39"/>
            <Setter Property="VerticalGridLinesBrush" Value="#222B39"/>
            <Setter Property="RowBackground" Value="#0F151D"/>
            <Setter Property="AlternatingRowBackground" Value="#121923"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ResultGridHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource ResultGridCellStyle}"/>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#334257"/>
            <Setter Property="BorderBrush" Value="#3E4C63"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0B0F14"/>
            <Setter Property="Foreground" Value="#273142"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#334257"
                                           BorderBrush="#3E4C63"
                                           BorderThickness="1"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TopCardTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            Background="#0B0F14"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Image Source="{Binding IconPath}"
                               Width="38"
                               Height="38"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Width="16"
                                Height="16"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                Background="{Binding FullStackSalesBrush}"
                                CornerRadius="8"
                                ToolTip="{Binding FullStackSalesTooltip}">
                            <TextBlock Text="99"
                                       Foreground="#0B0F14"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}">
                            <Run Text="Lv."/>
                            <Run Text="{Binding Level, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding RequirementType, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding RequirementValue, Mode=OneWay}"/>
                            <Run Text=" / x"/>
                            <Run Text="{Binding Quantity, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}">
                            <Run Text="販売平均 "/>
                            <Run Text="{Binding SaleAverageText, Mode=OneWay}"/>
                            <Run Text=" / 最安 "/>
                            <Run Text="{Binding LowestPriceText, Mode=OneWay}"/>
                            <Run Text=" / 売個 "/>
                            <Run Text="{Binding SalesQuantity, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="{Binding ScoreText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock Text="Score"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,8,0"/>
                            <Button Content="⧉"
                                    ToolTip="アイテム名をコピー"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DataContext.CopyItemNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Click="CopyButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top"
                Height="42"
                Background="#070A0F"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Image Source="Resource/RetainerMarketScout.ico"
                           Width="18"
                           Height="18"
                           Margin="0,0,10,0"
                           Stretch="Uniform"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="FF14 Retainer Market Scout"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="  /  Universalis"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="─"
                        Style="{StaticResource TitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click"/>
                <Button Grid.Column="2"
                        Content="▢"
                        Style="{StaticResource TitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click"/>
                <Button Grid.Column="3"
                        Content="×"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Padding="18"
                Background="#0E141C"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="データセンター" Margin="0,0,10,0" Foreground="{StaticResource SubtleTextBrush}"/>
                <ComboBox Grid.Column="1"
                          Height="32"
                          IsEditable="False"
                          ItemsSource="{Binding DataCenters}"
                          SelectedItem="{Binding SelectedDataCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2" Text="ワールド" Margin="14,0,10,0" Foreground="{StaticResource SubtleTextBrush}"/>
                <ComboBox Grid.Column="3"
                          Height="32"
                          IsEditable="False"
                          ItemsSource="{Binding Worlds}"
                          SelectedItem="{Binding SelectedWorld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="4" Content="{Binding RefreshButtonText}" Command="{Binding RefreshOrCancelCommand}"/>
                <Button Grid.Column="5" Content="候補CSVを開く" MinWidth="135" Command="{Binding OpenItemsCsvCommand}"/>
                <Button Grid.Column="6" Content="Universalisで見る" MinWidth="150" Command="{Binding OpenSelectedMarketCommand}"/>
                <TextBlock Grid.Column="7" Text="同時接続" Margin="16,0,8,0" Foreground="{StaticResource SubtleTextBrush}"/>
                <TextBox Grid.Column="8"
                         Width="48"
                         Height="30"
                         Text="{Binding MaxConcurrentRequests, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="9"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <CheckBox Content="更新前にExpressVPN MCPで接続する"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ConnectExpressVpnBeforeRefresh, Mode=TwoWay}"/>
                    <TextBlock Text="MCP/接続先" Margin="18,0,8,0" Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBox Width="300"
                             Height="30"
                             Text="{Binding ExpressVpnLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="直近日数" Margin="18,0,8,0" Foreground="{StaticResource SubtleTextBrush}"/>
                    <TextBox Width="48"
                             Height="30"
                             Text="{Binding RecentSalesDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Score = 販売平均 x 推定取得数 x 売れやすさ（件数・個数） x 直近販売"
                               Margin="18,0,0,0"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="#0E141C"
                   BorderBrush="{StaticResource BorderBrushDark}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubtleTextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="園芸 Top 3" Style="{StaticResource SectionTitleStyle}"/>
                    <ItemsControl Grid.Row="1" Margin="0,12,0,8" ItemsSource="{Binding TopBotanistResults}" ItemTemplate="{StaticResource TopCardTemplate}"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding BotanistResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" MouseDoubleClick="ResultsGrid_MouseDoubleClick" Style="{StaticResource ResultGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⧉"
                                                ToolTip="アイテム名をコピー"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.CopyItemNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Click="CopyButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" SortMemberPath="Score" Width="58"/>
                            <DataGridTextColumn Header="素材" Binding="{Binding Name}" SortMemberPath="Name" Width="*"/>
                            <DataGridTextColumn Header="Lv" Binding="{Binding Level}" SortMemberPath="Level" Width="34"/>
                            <DataGridTextColumn Header="数" Binding="{Binding Quantity}" SortMemberPath="Quantity" Width="32"/>
                            <DataGridTextColumn Header="最安" Binding="{Binding LowestPriceText}" SortMemberPath="LowestPrice" Width="58"/>
                            <DataGridTextColumn Header="販" Binding="{Binding SalesCount}" SortMemberPath="SalesCount" Width="32"/>
                            <DataGridTextColumn Header="売個" Binding="{Binding SalesQuantity}" SortMemberPath="SalesQuantity" Width="42"/>
                            <DataGridTemplateColumn Header="印" SortMemberPath="FullStackSalesRank" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="14"
                                                Height="14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{Binding FullStackSalesBrush}"
                                                CornerRadius="7"
                                                ToolTip="{Binding FullStackSalesTooltip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="8,0,8,0" Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="採掘 Top 3" Style="{StaticResource SectionTitleStyle}"/>
                    <ItemsControl Grid.Row="1" Margin="0,12,0,8" ItemsSource="{Binding TopMinerResults}" ItemTemplate="{StaticResource TopCardTemplate}"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding MinerResults}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" MouseDoubleClick="ResultsGrid_MouseDoubleClick" Style="{StaticResource ResultGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⧉"
                                                ToolTip="アイテム名をコピー"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.CopyItemNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Click="CopyButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
